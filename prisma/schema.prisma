generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  category    String
  description String
  image       String
  active      Boolean    @default(true)
  featured    Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([category])
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  business  String?
  product   String?
  line      String?
  message   String?
  source    String   @default("website")
  status    String   @default("new")
  createdAt DateTime @default(now())
  @@index([status])
}
